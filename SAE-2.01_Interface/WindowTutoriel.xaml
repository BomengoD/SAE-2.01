<Window x:Class="SAE_2._01_Interface.WindowTutoriel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_2._01_Interface"
        mc:Ignorable="d"
        Title="WindowTutoriel" Height="540" Width="800"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#2C3E50">
            <Grid Margin="24,0">
                <TextBlock Text="TUTORIEL" Foreground="White" FontSize="16" FontWeight="Bold"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxbNumeroEtape" Foreground="#7F8C8D" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">

                <TextBlock x:Name="TxbTitreEtape" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#2C3E50"/>

                <TextBlock x:Name="TxbDescription" FontSize="13" TextWrapping="Wrap" LineHeight="24" Foreground="#555"/>

                <Border x:Name="BdrAstuce" Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡 " FontSize="13"/>
                        <TextBlock x:Name="TxbAstuce" FontSize="12" TextWrapping="Wrap" Foreground="#1A5276" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="#1B4F72" CornerRadius="10" Padding="14,10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Grid x:Name="GridFleche" Height="26" Margin="0,0,0,3"/>
                    <Grid x:Name="GridPlateau"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F4F6F7" BorderBrush="#D5D8DC" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">

                <StackPanel x:Name="SpProgres" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Button x:Name="BtnPrecedent" Content="◀  Précédent" Padding="12,6" Margin="0,0,6,0" IsEnabled="False" Click="BtnPrecedent_Click"/>

                    <Button x:Name="BtnSuivant" Content="Suivant  ▶" Padding="14,6" Background="#2980B9" Foreground="White" BorderBrush="#2471A3" Click="BtnSuivant_Click"/>

                    <Button x:Name="BtnTerminer" Content="Commencer à jouer  ✓" Padding="14,6" Visibility="Collapsed" Background="#27AE60" Foreground="White" BorderBrush="#1E8449" Click="BtnTerminer_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
