<Window x:Class="SAE_2._01_Interface.ConsulterSucces"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_2._01_Interface"
        mc:Ignorable="d"
        Title="WindowConsulterSucces" Height="450" Width="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5">
                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="BtnHome_Click">
                    <TextBlock Text="🏠" FontSize="30" Height="41" Width="42"/>
                </Button>
                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Click="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="30" Height="41" Width="42"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="70,20,69,50">
                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔑" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Première connexion"/>
                            <TextBlock Text="Créer un profil" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏆" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Première victoire"/>
                            <TextBlock Text="Remporter votre première partie" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💔" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Première défaite"/>
                            <TextBlock Text="Perdre votre première partie" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⭐" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="10 victoires"/>
                            <TextBlock Text="Remporter 10 parties" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💀" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="10 défaites"/>
                            <TextBlock Text="Perdre 10 parties" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🤖" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Victoire contre l'IA facile"/>
                            <TextBlock Text="Vaincre l'IA en difficulté facile" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🤖" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Victoire contre l'IA moyenne"/>
                            <TextBlock Text="Vaincre l'IA en difficulté moyenne" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🤖" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Victoire contre l'IA difficile"/>
                            <TextBlock Text="Vaincre l'IA en difficulté difficile" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎯" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Victoire en mode challenge"/>
                            <TextBlock Text="Gagner une partie en mode challenge" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border BorderThickness="1" BorderBrush="Black" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⏱️" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Victoire chronométrée"/>
                            <TextBlock Text="Gagner une partie en mode chronométré" FontSize="10" Margin="5,0,0,5"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>