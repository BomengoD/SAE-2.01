<Window x:Class="SAE_2._01_Interface.WindowProfil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_2._01_Interface"
        mc:Ignorable="d"
        Title="WindowProfil" Height="450" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="3">Création du Profil</TextBlock>

                <StackPanel Grid.Column="1" Grid.Row="1">
                    <Image Source="/assets/profil.png" Height="75"/>
                    <Button Name="BtnModifier">Modifier</Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="2">
                    <TextBlock Name="TxbProfilNom">Nom</TextBlock>
                    <TextBox Name="TxtProfilNom"></TextBox>
                    <TextBlock Name="TxbErreurProfilNom" Foreground="Red"></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="3">
                    <TextBlock Name="TxbMDP">Mot de passe</TextBlock>
                    <TextBox Name="TxtMDP"></TextBox>
                    <TextBlock Name="TxbErreurMDP" Foreground="Red"></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="4">
                    <TextBlock Name="TxbMDPConfirm">Confirmer le mot de passe</TextBlock>
                    <TextBox Name="TxtMDPConfirm"></TextBox>
                    <TextBlock Name="TxbErreurMDPConfirm" Foreground="Red"></TextBlock>
                </StackPanel>

                <Button Name="BtnReinitialiser" Grid.Row="5" Click="BtnReinitialiser_Click">Réinitialiser</Button>
                <Button Name="BtnValider" Grid.Column="2" Grid.Row="5" Click="BtnValider_Click">Valider</Button>
            
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
