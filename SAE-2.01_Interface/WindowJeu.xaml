<Window x:Class="SAE_2._01_Interface.WindowJeu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAE_2._01_Interface"
        mc:Ignorable="d"
        Title="WindowJeu" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1a1a2e" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Lignes :" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Name="SliderLignes" Minimum="6" Maximum="10" Value="6" Width="110" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Name="LabelLignes" Text="6" Foreground="Cyan" FontSize="14" FontWeight="Bold" Width="24" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Colonnes :" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Name="SliderColonnes" Minimum="7" Maximum="11" Value="7" Width="110" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Name="LabelColonnes" Text="7" Foreground="Cyan" FontSize="14" FontWeight="Bold" Width="24" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Jetons à aligner :" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Name="LabelJetons" Text="4" Foreground="Orange" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Name="BoutonNouveau" Content="Nouvelle partie" FontSize="14" FontWeight="Bold" Padding="16,6" Background="#e94560" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BoutonNouveau_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Background="#0f3460">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Name="LabelStatut" Grid.Row="0" Text="Configurez la partie puis cliquez sur Nouvelle partie." FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10" Foreground="White"/>

            <Border Grid.Row="1" Margin="20,0,20,20" Background="#16213e" CornerRadius="8" Padding="8">
                <UniformGrid Name="Grille" Background="Transparent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
