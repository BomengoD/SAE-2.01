<Window x:Class="SAE_2._01_Interface.WindowConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil" Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">

    <Border Margin="20" Background="White" CornerRadius="15" Padding="20">
        <StackPanel>

            <TextBlock Text="Connexion au Profil" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Identifiant" FontSize="14"/>
            <TextBox x:Name="TxtId" Height="30" Margin="0,5,0,15" FontSize="14"/>

            <TextBlock Text="Mot de passe" FontSize="14"/>
            <PasswordBox x:Name="TxtMdp" Height="30" Margin="0,5,0,20" FontSize="14"/>

            <Button Content="Se connecter" Height="40" Background="Gray" Foreground="White" FontSize="16" BorderThickness="0" Cursor="Hand" Click="BtnConnexion_Click"/>
            <Button Content="Retour au menu" Height="35" Margin="0,15,0,0" Background="Transparent" BorderBrush="Gray" Foreground="Black" Cursor="Hand" Click="BtnRetour_Click"/>

        </StackPanel>
    </Border>
</Window>
