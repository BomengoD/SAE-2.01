<Window x:Class="SAE_2._01_Interface.WindowConfPartie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration de la partie" Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

           
            <DockPanel Margin="0 0 0 20">
                <Button Width="40" Height="40" DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" ToolTip="Retour à l'accueil"/>

                <TextBlock Text="Configurer la partie" FontSize="28" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="10 0 0 0"/>
            </DockPanel>

            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Type de partie" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>
                
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnPartieNormale" Content="Partie normale" Tag="Normal" Click="BtnMode_Click" Height="40" Margin="50,0,10,0" Width="128"/>
                    <Button x:Name="btnChrono" Content="Chronométrée" Tag="Chronometre" Click="BtnMode_Click" Height="40" Margin="100,0,0,0" Width="128"/>
                    <Button x:Name="btnChallenge" Content="Challenge (3 d'affilés)" Tag="Challenge" Click="BtnMode_Click" Height="40" Margin="100,0,0,0" Width="128"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Taille de la grille" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btn4x5" Content="4 x 5" Tag="4,5" Height="40" Width="40" Margin="30,0,10,0" Click="BtnGrille_Click"/>
                    <Button x:Name="btn6x7" Content="6 x 7" Tag="6,7" Height="40" Width="40" Margin="35,0,10,0" Click="BtnGrille_Click"/>
                    <Button x:Name="btn8x9" Content="8 x 9" Tag="8,9" Height="40" Width="40" Margin="35,0,10,0" Click="BtnGrille_Click"/>
                    <Button x:Name="btn10x11" Content="10 x 11" Tag="10,11" Height="40" Width="42" Margin="35,0,0,0" Click="BtnGrille_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Jetons à aligner" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtJetons" Text="Nombre de jetons :" VerticalAlignment="Center"/>
                    <TextBox Width="60" Height="20" Text="4" Margin="10 0 0 0"/>
                </StackPanel>
            </StackPanel>

           
            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Adversaire" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>
                <Button x:Name="btnInvite" Content="Jouer contre l’invité" Tag="Invite" Click="BtnAdversaire_Click" Height="40" Margin="0 0 0 10"/>
                <Button x:Name="btnIA" Content="Jouer contre l’IA" Tag="IA" Height="40"/>
            </StackPanel>

            <StackPanel Margin="0 20 0 0">
                <Button x:Name="btnLancer" Content="Lancer la partie" Height="50" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0 0 0 15" Click="btnLancer_Click"/>
                <Button Content="Réinitialiser" Height="40" Background="#DDDDDD" Foreground="#333"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
