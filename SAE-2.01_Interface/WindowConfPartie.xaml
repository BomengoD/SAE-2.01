<Window x:Class="SAE_2._01_Interface.WindowConfPartie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration de la partie" Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

           
            <DockPanel Margin="0 0 0 20">
                <Button Width="40" Height="40" DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" ToolTip="Retour à l'accueil"/>

                <TextBlock Text="Configurer la partie" FontSize="28" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="10 0 0 0"/>
            </DockPanel>

            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Type de partie" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>
                
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnPartieNormale" Content="Partie normale" Height="40" Margin="50,0,10,0" Width="127.903333333333" Click="btnPartieNormale_Click"/>
                    <Button x:Name="btnChrono" Content="Chronométrée" Height="40" Margin="100,0,0,0" Width="127.903333333333"/>
                    <Button x:Name="btnChallenge" Content="Challenge (3 difficultés)" Height="40" Margin="100,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Taille de la grille" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btn5x4" Content="5 x 4" Height="40" Margin="30,0,10,0" Width="40"/>
                    <Button x:Name="btn7x6" Content="7 x 6" Height="40" Margin="35,0,10,0" Width="40" Click="btn7x6_Click"/>
                    <Button x:Name="btn9x8" Content="9 x 8" Height="40" Margin="35,0,10,0" Width="40"/>
                    <Button x:Name="btn11x10" Content="11 x 10" Height="40" Width="42" Margin="35,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Jetons à aligner" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtJetons" Text="Nombre de jetons :" VerticalAlignment="Center" DataContextChanged="txtJetons_TextChanged"/>
                    <TextBox Width="60" Height="20" Text="4" Margin="10 0 0 0"/>
                </StackPanel>
            </StackPanel>

           
            <StackPanel Margin="0 0 0 25">
                <TextBlock Text="Adversaire"
                           FontSize="20" FontWeight="SemiBold"
                           Margin="0 0 0 10"/>

                <Button x:Name="btnInvite" Content="Jouer contre l’invité" Height="40" Margin="0 0 0 10"/>
                <Button x:Name="btnIA" Content="Jouer contre l’IA" Height="40"/>
            </StackPanel>

            <StackPanel Margin="0 20 0 0">
                <Button x:Name="btnLancer" Content="Lancer la partie" Height="50" Background="#4CAF50" Foreground="White"
                        FontWeight="Bold"
                        Margin="0 0 0 15" Click="btnLancer_Click"/>

                <Button Content="Réinitialiser"
                        Height="40"
                        Background="#DDDDDD"
                        Foreground="#333"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
